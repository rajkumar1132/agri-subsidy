// ============================================================
// Prisma Schema — Smart Agricultural Subsidy Management System
// Database: MySQL | Normalization: BCNF
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── USER — Base entity for all system participants ──────────
model User {
  user_id    Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  email      String   @unique @db.VarChar(100)
  password   String   @db.VarChar(255)
  contact_no String   @db.VarChar(15)
  address    String   @db.VarChar(200)
  user_type  UserType
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // ISA relationships
  farmer         Farmer?
  equipmentOwner EquipmentOwner?

  // Audit trail
  auditLogs          AuditLog[]
  subsidyApprovals   SubsidyApplication[] @relation("ApprovedBy")

  @@index([user_type])
  @@map("users")
}

enum UserType {
  ADMIN
  FARMER
  EQUIPMENT_OWNER
  VERIFIER
  PROGRAM_OFFICER
}

// ── FARMER — Specialization of User (ISA) ───────────────────
model Farmer {
  user_id    Int    @id
  aadhaar_no String @unique @db.VarChar(12)
  land_area  Float

  user    User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  rentals Rental[]

  @@map("farmers")
}

// ── EQUIPMENT_OWNER — Specialization of User (ISA) ──────────
model EquipmentOwner {
  user_id   Int         @id
  user      User        @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  equipment Equipment[]

  @@map("equipment_owners")
}

// ── EQUIPMENT — Equipment available for sharing ─────────────
model Equipment {
  equipment_id Int             @id @default(autoincrement())
  name         String          @db.VarChar(100)
  type         String          @db.VarChar(50)
  rental_rate  Float
  status       EquipmentStatus @default(AVAILABLE)
  owner_id     Int
  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt

  owner   EquipmentOwner @relation(fields: [owner_id], references: [user_id], onDelete: Cascade)
  rentals Rental[]

  @@index([owner_id])
  @@index([status])
  @@index([type])
  @@map("equipment")
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
}

// ── RENTAL — Equipment rental transactions ──────────────────
model Rental {
  rental_id    Int          @id @default(autoincrement())
  farmer_id    Int
  equipment_id Int
  duration     Int          // days
  total_amount Float
  status       RentalStatus @default(REQUESTED)
  verified     Boolean      @default(false)
  rental_date  DateTime     @default(now())
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt

  farmer    Farmer    @relation(fields: [farmer_id], references: [user_id])
  equipment Equipment @relation(fields: [equipment_id], references: [equipment_id])

  subsidyApplication SubsidyApplication?

  @@index([farmer_id])
  @@index([equipment_id])
  @@index([status])
  @@map("rentals")
}

enum RentalStatus {
  REQUESTED
  APPROVED
  COMPLETED
  VERIFIED
}

// ── SUBSIDY_APPLICATION — Linked to verified rental ─────────
model SubsidyApplication {
  application_id   Int            @id @default(autoincrement())
  rental_id        Int            @unique
  subsidy_amount   Float
  approval_status  ApprovalStatus @default(PENDING)
  remarks          String?        @db.Text
  officer_id       Int?
  application_date DateTime       @default(now())
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  rental  Rental @relation(fields: [rental_id], references: [rental_id])
  officer User?  @relation("ApprovedBy", fields: [officer_id], references: [user_id])

  @@index([approval_status])
  @@map("subsidy_applications")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── AUDIT_LOG — Tracks all system actions ───────────────────
model AuditLog {
  log_id      Int      @id @default(autoincrement())
  user_id     Int
  action      String   @db.VarChar(100)
  entity_type String   @db.VarChar(50)
  entity_id   Int?
  details     String?  @db.Text
  timestamp   DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@index([timestamp])
  @@map("audit_logs")
}
